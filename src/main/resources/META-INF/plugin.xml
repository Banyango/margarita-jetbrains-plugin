<!-- Plugin Configuration File: https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin>
    <!-- Unique identifier of the plugin. It should be FQN, cannot be changed between the plugin versions. -->
    <id>com.margarita.margarita-jetbrains-plugin</id>

    <!-- Public plugin name should be written in Title Case.
         Guidelines: https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html#plugin-name -->
    <name>Margarita</name>

    <!-- A displayed Vendor name or Organization ID displayed on the Plugins Page. -->
    <vendor url="https://www.yourcompany.com">Banyango</vendor>

    <!-- Description of the plugin displayed on the Plugin Page and IDE Plugin Manager.
         Guidelines: https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html#plugin-description -->
    <description><![CDATA[
        Margarita language support with syntax highlighting for markdown-based templating.

        Margarita is a lightweight markup language and Python library for writing, composing, and rendering structured LLM prompts.

        It renders out to Markdown format by default so you can use this anywhere Markdown is supported.

        Margarita extends Markdown with templating features like variables, conditionals, loops, and includes, making it easy to create dynamic prompts for large language models (LLMs).

        [[ More about Margarita: https://github.com/Banyango/margarita ]]
    ]]></description>

    <!-- Product and plugin compatibility requirements.
         Read more: https://plugins.jetbrains.com/docs/intellij/plugin-compatibility.html -->
    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.modules.lang</depends>

    <resource-bundle>messages.MyMessageBundle</resource-bundle>
    <!-- Extensions defined by the plugin.
         Read more: https://plugins.jetbrains.com/docs/intellij/plugin-extension-points.html -->
    <extensions defaultExtensionNs="com.intellij">
        <!-- Margarita language support -->
        <fileType name="Margarita File"
                  language="MargaritaScript"
                  implementationClass="com.margarita.margaritajetbrainsplugin.MargaritaScriptLanguageType"
                  fieldName="INSTANCE"
                  extensions="mg"/>
        <lang.parserDefinition
                language="MargaritaScript"
                implementationClass="com.margarita.margaritajetbrainsplugin.MargaritaParserDefinition"/>
        <lang.syntaxHighlighterFactory
                language="MargaritaScript"
                implementationClass="com.margarita.margaritajetbrainsplugin.MargaritaSyntaxHighlighterFactory"/>
        <colorSettingsPage implementation="com.margarita.margaritajetbrainsplugin.MargaritaColorSettingsPage"/>
        <!-- Register our reference contributor to resolve include filenames [[ ... ]] -->
        <psi.referenceContributor language="MargaritaScript" implementation="com.margarita.margaritajetbrainsplugin.IncludeReferenceContributor"/>
        <!-- Register GotoDeclaration handler so Ctrl/Cmd+click navigation can be handled -->
        <gotoDeclarationHandler implementation="com.margarita.margaritajetbrainsplugin.IncludeGotoDeclarationHandler"/>
    </extensions>
</idea-plugin>